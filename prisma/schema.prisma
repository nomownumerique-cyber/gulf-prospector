generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Prospect {
  id              String   @id @default(cuid())
  name            String
  category        String
  city            String
  country         String   @default("UAE")
  address         String?
  phone           String?
  website         String?
  instagram       String?
  facebook        String?
  tiktok          String?
  rating          Float?
  reviewsCount    Int?
  hasWebsite      Boolean  @default(false)
  hasSocial       Boolean  @default(false)
  weaknessScore   Int      @default(0)
  payAbilityScore Int      @default(0)
  status          String   @default("new")
  notes           String?
  searchId        String?
  search          Search?  @relation(fields: [searchId], references: [id])
  audits          Audit[]
  emailDrafts     EmailDraft[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Search {
  id           String     @id @default(cuid())
  query        String
  country      String
  city         String
  category     String
  maxResults   Int        @default(50)
  status       String     @default("pending")
  apifyRunId   String?
  resultsCount Int        @default(0)
  prospects    Prospect[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model Audit {
  id              String   @id @default(cuid())
  prospectId      String
  prospect        Prospect @relation(fields: [prospectId], references: [id])
  findings        String
  recommendations String
  competitorGap   String?
  createdAt       DateTime @default(now())
}

model EmailDraft {
  id         String   @id @default(cuid())
  prospectId String
  prospect   Prospect @relation(fields: [prospectId], references: [id])
  subject    String
  bodyAr     String
  bodyEn     String
  status     String   @default("draft")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
